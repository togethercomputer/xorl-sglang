--- a/csrc/smxx/decode/get_decoding_sched_meta/get_decoding_sched_meta.cu
+++ b/csrc/smxx/decode/get_decoding_sched_meta/get_decoding_sched_meta.cu
@@ -205,6 +205,68 @@ get_mla_metadata_kernel_low_smem(__grid_constant__ const GetDecodeSchedMetaParam
     FLASH_DEVICE_ASSERT(now_req_idx == batch_size && now_block == 0 && now_n_split_idx == 0);
 }

+// MODEL1 uses a request-local, batch-invariant schedule. Every request owns
+// exactly two scheduler entries, so changing or permuting neighboring rows
+// cannot change this request's reduction program.
+__global__ void __launch_bounds__(32, 1, 1)
+get_model1_mla_metadata_kernel(__grid_constant__ const GetDecodeSchedMetaParams params) {
+    if (threadIdx.x != 0) {
+        return;
+    }
+
+    int cumulative_splits = 0;
+    params.num_splits_ptr[0] = 0;
+    for (int req_idx = 0; req_idx < params.b; ++req_idx) {
+        int effective_seq_len = get_effective_seq_len(params, req_idx, params.block_size_n);
+        int num_blocks = max(
+            (effective_seq_len + params.block_size_n - 1) / params.block_size_n,
+            1);
+
+        DecodingSchedMeta* first = params.tile_scheduler_metadata_ptr + 2 * req_idx;
+        first->begin_req_idx = req_idx;
+        first->end_req_idx = req_idx;
+        first->begin_block_idx = 0;
+        first->end_block_idx = 0;
+        first->begin_split_idx = 0;
+        first->is_first_req_splitted = false;
+        first->is_last_req_splitted = false;
+        first->_pad[0] = 0;
+
+        DecodingSchedMeta* second = first + 1;
+        second->begin_req_idx = params.b;
+        second->end_req_idx = params.b;
+        second->begin_block_idx = 0;
+        second->end_block_idx = 0;
+        second->begin_split_idx = 0;
+        second->is_first_req_splitted = false;
+        second->is_last_req_splitted = false;
+        second->_pad[0] = 0;
+        if (num_blocks == 1) {
+            first->end_block_idx = 1;
+
+            // Sparse decode kernels already treat begin_req_idx >= b as an
+            // empty scheduler entry.
+            cumulative_splits += 1;
+        } else {
+            int midpoint = (num_blocks + 1) / 2;
+            first->end_block_idx = midpoint;
+            first->is_first_req_splitted = true;
+            first->is_last_req_splitted = true;
+
+            second->begin_req_idx = req_idx;
+            second->end_req_idx = req_idx;
+            second->begin_block_idx = midpoint;
+            second->end_block_idx = num_blocks;
+            second->begin_split_idx = 1;
+            second->is_first_req_splitted = true;
+            second->is_last_req_splitted = true;
+            cumulative_splits += 2;
+        }
+
+        params.num_splits_ptr[req_idx + 1] = cumulative_splits;
+    }
+}
+
 void run_get_decoding_sched_meta_kernel(GetDecodeSchedMetaParams &params) {
     int smem_size = sizeof(int) * (params.b*5+1);
     int max_smem = 0;
@@ -232,4 +294,10 @@ void run_get_decoding_sched_meta_kernel(GetDecodeSchedMetaParams &params) {
     CHECK_CUDA_KERNEL_LAUNCH();
 }

+void run_get_model1_decoding_sched_meta_kernel(GetDecodeSchedMetaParams &params) {
+    FLASH_ASSERT(params.num_sm_parts == 2 * params.b);
+    get_model1_mla_metadata_kernel<<<1, 32, 0, params.stream>>>(params);
+    CHECK_CUDA_KERNEL_LAUNCH();
+}
+
 }
